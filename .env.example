# ==============================================================================
# AURA LUXE ELECTRONICS - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & DOMAIN CONFIGURATION
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_STORE_NAME="Aura Luxe Electronics"

# ------------------------------------------------------------------------------
# 2. SUPABASE POSTGRESQL & AUTHENTICATION (Mandatory)
# Get these from your Supabase Dashboard -> Project Settings -> API
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# STRICTLY SERVER-SIDE. Never prefix with NEXT_PUBLIC_ or expose to client!
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 3. RAZORPAY PAYMENT GATEWAY (Indian Statutory Payment Gateway)
# Generate from Razorpay Dashboard -> Settings -> API Keys & Webhooks
# ------------------------------------------------------------------------------
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_your_key_id_here
RAZORPAY_KEY_ID=rzp_live_your_key_id_here
RAZORPAY_KEY_SECRET=your_super_secret_razorpay_secret_here
RAZORPAY_WEBHOOK_SECRET=your_configured_webhook_secret_here

# ------------------------------------------------------------------------------
# 4. GOOGLE MAPS & DIRECTIONS API (Fleet Navigation & Address Geocoding)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_MAPS_KEY=AIzaSyYourGoogleMapsApiKeyHere

# ------------------------------------------------------------------------------
# 5. COMMUNICATIONS & NOTIFICATIONS
# ------------------------------------------------------------------------------
# Email (Resend / SendGrid / Postmark)
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM="concierge@yourluxurybrand.com"

# SMS (MSG91 / Twilio)
SMS_PROVIDER=msg91
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_SENDER_ID=AURALX
MSG91_TEMPLATE_ID=your_dlt_approved_template_id

# WhatsApp Business Cloud API
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token

# ------------------------------------------------------------------------------
# 6. STATUTORY BUSINESS & TAX CREDENTIALS (Overrides CMS if provided)
# ------------------------------------------------------------------------------
SELLER_LEGAL_NAME="Aura Luxe Electronics Private Limited"
SELLER_GSTIN="27AABCU9603R1ZM"
SELLER_CIN="U72200MH2024PTC123456"
SELLER_STATE_CODE="27"
